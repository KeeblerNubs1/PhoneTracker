<Window x:Class="PhoneTracker.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PhoneTracker" Width="1000" Height="650">
<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel Orientation="Horizontal"><TextBlock Text="API:" VerticalAlignment="Center"/><TextBox x:Name="ApiBox" Width="300" Margin="8,0" Text="http://localhost:5080"/><Button Content="Create Pairing" Click="CreatePairing_Click"/><TextBlock Text=" Code:" Margin="16,0,4,0"/><TextBlock x:Name="CodeText" FontWeight="Bold"/></StackPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12"><TextBlock Text="Status: " FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="Not paired"/><TextBlock Text="  Device: " FontWeight="Bold" Margin="20,0,0,0"/><TextBlock x:Name="DeviceText"/><TextBlock Text="  Location: " FontWeight="Bold" Margin="20,0,0,0"/><TextBlock x:Name="LocationText"/></StackPanel>
<Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1"><TextBlock x:Name="MapText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Text="Waiting for location..."/></Border>
</Grid></Window>
